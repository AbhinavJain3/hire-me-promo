rules_version = '2';
// HireMe Engagement Engine (DATA_MODEL §4.9): no client SDK access to any collection.
// Only engine service accounts (Admin SDK, which bypasses rules) and the engine admin API touch data.
// The admin console never reads Firestore directly (D-039).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
